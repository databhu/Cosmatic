# Copy this file to .env and fill in your real values.
# .env is gitignored - it's only for local development. Never commit your
# real API key(s). For Streamlit Community Cloud, use Settings -> Secrets
# instead (see README.md).

# AI features (Formula Studio generation/refinement + AI Assistant tab) need
# at least one Gemini API key. Get a free key (no credit card required) at
# https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Optional - a second Gemini key. If set, the app automatically switches to
# this one if the first key hits its rate limit or otherwise fails - no
# action needed on your part when that happens.
GEMINI_API_KEY_2=your_backup_gemini_api_key_here

# There is no model selection to configure - the app always tries
# gemini-3.5-flash-lite first and automatically falls back through other
# Gemini models on its own (deprecated model, rate limit, incompatible
# response, etc.). See utils/ai_client.py's GEMINI_MODELS list.
